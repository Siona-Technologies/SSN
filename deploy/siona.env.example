# SIONA production environment (systemd EnvironmentFile)
# Copy to /etc/siona/siona.env and edit — never commit secrets.

SSN_OFFLINE=1
SSN_STRUCTURED_LOG=1
SSN_HTTP_QUIET=1

SSN_STATE_DIR=/var/lib/siona/state
SSN_RATE_LIMIT_PATH=/var/lib/siona/state/rate_limits.json
SSN_KNOWLEDGE_PATH=/opt/siona/ssn/knowledge/knowledge.jsonl

SSN_HOME_LAW_PATH=/opt/siona/ssn/policy/home_law_samson.yaml
SSN_WORLD_LAW_PATH=/opt/siona/ssn/policy/world_law.yaml
SSN_SYSTEM_LAW_PATH=/opt/siona/ssn/policy/system_law.yaml

SSN_HTTP_HOST=0.0.0.0
SSN_HTTP_PORT=8080

# LLM (optional)
SSN_LLM_PROVIDER=dummy
# SSN_LLM_PROVIDER=http
# SSN_LLM_ENDPOINT=http://127.0.0.1:8000/generate

# Embeddings (optional)
SSN_EMBEDDING_PROVIDER=deterministic
# SSN_EMBEDDING_PROVIDER=http
# SSN_EMBEDDING_ENDPOINT=http://127.0.0.1:8002/embed

# OWNER key — set locally only
SSN_MASTER_KEY=
