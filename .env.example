# .env.example (SAFE TEMPLATE — no real secrets)

SSN_OFFLINE=1
SSN_LIVE_SEARCH=0
SSN_LIVE_STRICT=0

# NEVER put a real key here
SSN_BRAVE_API_KEY=

SSN_BRAVE_COUNTRY=US
SSN_BRAVE_LANG=en


SSN_STATE_DIR=.ssn_state
SSN_RATE_LIMIT_PATH=.ssn_state/rate_limits.json

# LLM provider selection (see LLM_STRATEGY_V10.md)
# SSN_LLM_PROVIDER can be:
#   dummy  (default)  -> LocalDummyLLMProvider (no external model)
#   http              -> HttpLLMProvider (local/remote HTTP endpoint)
SSN_LLM_PROVIDER=dummy

# When using SSN_LLM_PROVIDER=http, set the local inference URL here
# e.g. http://localhost:8000/generate
# Start mock server: python scripts/mock_llm_server.py
SSN_LLM_ENDPOINT=

# Optional fast/deep endpoints (Phase 1 routing; fallback to SSN_LLM_ENDPOINT)
# SSN_LLM_ENDPOINT_FAST=http://127.0.0.1:8000/generate
# SSN_LLM_ENDPOINT_DEEP=http://127.0.0.1:8001/generate

# OWNER master key (local dev only — never commit real value)
SSN_MASTER_KEY=

SSN_KNOWLEDGE_PATH=ssn/knowledge/knowledge.jsonl

# Embeddings / knowledge RAG (Phase 5)
# SSN_EMBEDDING_PROVIDER=deterministic
# SSN_EMBEDDING_ENDPOINT=http://127.0.0.1:8002/embed
# SSN_EMBEDDING_DIM=64
# Mock embed server: python scripts/mock_embed_server.py

# Structured JSON logging (Phase 6 — production systemd)
# SSN_STRUCTURED_LOG=1
# SSN_HTTP_QUIET=1

# Law paths (Phase 3 — defaults = Samson deployment #1)
# SSN_HOME_LAW_PATH=ssn/policy/home_law_samson.yaml
# SSN_WORLD_LAW_PATH=ssn/policy/world_law.yaml
# SSN_SYSTEM_LAW_PATH=ssn/policy/system_law.yaml
# SSN_TENANT_ID=
# SSN_HTTP_HOST=127.0.0.1
# SSN_HTTP_PORT=8080
# SSN_HTTP_QUIET=0

SSN_DEBUG=0
SSN_TOOL_DEBUG=0
