# ============================
# SIONA / SSN Environment (Example)
# Copy to .env (DO NOT COMMIT .env)
# ============================

# ---- Mode controls ----
# Force offline mode for deterministic tests (recommended default for CI)
SSN_OFFLINE=1

# Enable live search (only for local/manual runs; keep OFF in CI)
SSN_LIVE_SEARCH=0

# Strict live means: no mock fallback if providers fail
SSN_LIVE_STRICT=0

# ---- Search provider configuration ----
# Brave Search API key (NEVER commit; keep empty in .env.example)
SSN_BRAVE_API_KEY=BSARm5pgAUK1E60IgqubJM59hCSiB1A

# Optional tuning
SSN_BRAVE_COUNTRY=KE
SSN_BRAVE_LANG=en

# ---- State / persistence ----
# Where pending memory proposals + commit history are stored
# If not set, your code should default to something safe (e.g., .ssn_state)
SSN_STATE_DIR=.ssn_state

# Rate limit store path (file-backed)
# If not set, your code should default to a safe file under SSN_STATE_DIR
SSN_RATE_LIMIT_PATH=.ssn_state/rate_limits.json

# ---- Optional: debugging ----
# Keep these off in CI unless troubleshooting
SSN_DEBUG=0
SSN_TOOL_DEBUG=0
