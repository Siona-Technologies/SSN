# Example tenant deployment — copy and customize for org #2

SSN_OFFLINE=1
SSN_TENANT_ID=org-example

# Isolated state (sessions, memory proposals, rate limits)
SSN_STATE_DIR=.ssn_state/tenants/org-example

# Tenant-specific law (bounded OWNER — not Samson ultimate authority)
SSN_HOME_LAW_PATH=deploy/tenant.example/home_law_org.yaml
SSN_WORLD_LAW_PATH=ssn/policy/world_law.yaml
SSN_SYSTEM_LAW_PATH=ssn/policy/system_law.yaml

SSN_KNOWLEDGE_PATH=.ssn_state/tenants/org-example/knowledge.jsonl

SSN_LLM_PROVIDER=dummy
