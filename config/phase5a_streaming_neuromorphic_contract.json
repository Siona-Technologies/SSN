  },
  "phase4_reference": {
    "artifact_path": "artifacts/neuromorphic/phase4b-lif-final-membrane-v1.json",
    "artifact_sha256": "dfc548e4247ad740ffc2c62c68fb9ad0f9af01bcaecbdb41527aeeb275f4fdcc",
    "task_id": "phase4a-temporal-salience-v1",
    "architecture_id": "phase4b-lif-final-membrane-v1",
    "window_shape": [20, 8],
    "artifact_mutation_authorized": false,
    "retraining_authorized": false
  },
  "streaming_step_event": {
    "modality": "temporal_salience_stream_v1",
    "event_must_be_neuromorphic_event": true,
    "event_id": {
      "type": "str",
      "required": true,
      "min_chars": 1,
      "max_chars": 128
    },
    "feature_keys_exact": ["channels", "sequence_index", "stream_id"],
    "stream_id": {
      "type": "str",
      "required": true,
      "min_chars": 1,
      "max_chars": 128
    },
    "sequence_index": {
      "type": "int",
      "bool_rejected": true,
      "min": 0,
      "max": 19
    },
    "channels": {
      "type": "list",
      "length": 8,
      "value_domain": [0, 1],
      "numeric_only": true,
      "bool_rejected": true,
      "nan_rejected": true,
      "infinity_rejected": true,
      "string_coercion_forbidden": true
    }
  },
  "stream_reset_event": {
    "modality": "temporal_salience_stream_v1",
    "feature_keys_exact": ["lifecycle_op", "stream_id"],
    "lifecycle_op": "stream_reset"
  },
  "temporal_dimensions": {
    "timesteps": 20,
    "channels_per_step": 8,
    "sequence_index_min": 0,
    "sequence_index_max": 19
  },
  "lifecycle": {
    "states": ["NONEXISTENT", "ACTIVE", "COMPLETED"],
    "initial_state": "NONEXISTENT",
    "legal_transitions": [
      {
        "from": "NONEXISTENT",
        "event": "valid_step_0",
        "to": "ACTIVE",
        "creates_stream": true
      },
      {
        "from": "ACTIVE",
        "event": "valid_next_step_1_to_18",
        "to": "ACTIVE"
      },
      {
        "from": "ACTIVE",
        "event": "valid_final_step_19",
        "to": "COMPLETED"
      },
      {
        "from": "ACTIVE",
        "event": "explicit_stream_reset",
        "to": "NONEXISTENT",
        "removes_stream": true
      },
      {
        "from": "COMPLETED",
        "event": "explicit_stream_reset",
        "to": "NONEXISTENT",
        "removes_stream": true
      },
      {
        "from": "ACTIVE",
        "event": "idle_ttl_expiry",
        "to": "NONEXISTENT",
        "removes_stream": true,
        "affects_other_streams": false
      },
      {
        "from": "COMPLETED",
        "event": "idle_ttl_expiry",
        "to": "NONEXISTENT",
        "removes_stream": true,
        "affects_other_streams": false
      },
      {
        "from": "ANY_RESIDENT",
        "event": "provider_wide_reset",
        "to": "NONEXISTENT",
        "removes_all_streams": true
      }
    ],
    "illegal_or_rejected": [
      "NONEXISTENT_PLUS_STEP_NOT_ZERO",
      "ACTIVE_DUPLICATE_SEQUENCE_INDEX",
      "ACTIVE_SKIPPED_SEQUENCE_INDEX",
      "ACTIVE_BACKWARDS_OR_OUT_OF_ORDER_INDEX",
      "COMPLETED_PLUS_ANY_STEP_WITHOUT_NEW_LIFECYCLE",
      "IMPLICIT_RESTART_OF_COMPLETED_STREAM",
      "MALFORMED_CLAIMED_STREAMING_EVENT",
      "CAPACITY_EXHAUSTION_WITHOUT_EXPIRY_SLOT"
    ],
    "no_implicit_restart_after_completion": true,
    "new_logical_stream_requires_explicit_lifecycle": true,
    "completed_stream_cannot_accept_extra_steps": true,
    "reuse_of_same_stream_id_after_expiry_or_reset_requires_new_step_0": true
  },
  "ordering_policy": {
    "first_step_must_be_zero": true,
    "subsequent_steps_must_equal_next_expected_index": true,
    "duplicate_step_rejected": true,
    "skipped_step_rejected": true,
    "out_of_order_or_backwards_step_rejected": true,
    "no_silent_coercion": true
  },
  "mutation_atomicity": {
    "validate_fully_before_any_learned_stream_mutation": true,
    "rejected_input_must_not_mutate": [
      "membrane_state",
      "spike_or_reset_state",
      "cumulative_spike_count",
      "next_expected_sequence_index",
      "completion_flag",
      "success_counters",
      "successful_activity_timestamps",
      "learned_output",
      "stream_lifecycle_state"
    ],
    "rejected_input_may_increment_failure_or_diagnostic_counters_only": true,
    "failed_event_must_not_appear_successfully_processed": true
  },
  "bounds": {
    "max_active_learned_streams": 256,
    "resident_stream_count_includes_active_and_completed_until_expiry_or_reset": true,
    "max_stream_id_chars": 128,
    "max_event_id_chars": 128,
    "channels_per_step": 8,
    "steps_per_stream": 20,
    "max_sequence_index": 19,
    "max_stored_temporal_raw_payload_history": 0,
    "retain_only_computational_lif_state": true,
    "alignment_note": "256 matches Phase 4 MAX_LEARNED_BATCH_EVENTS; 128 matches Phase 4 MAX_EVENT_ID_CHARS"
  },
  "idle_ttl": {
    "value": 30000,
    "unit": "milliseconds",
    "applies_to_states": ["ACTIVE", "COMPLETED"],
    "clock": "monotonic_idle_since_last_successful_stream_activity",
    "expiry_removes_only_expired_stream": true,
    "expiry_does_not_affect_other_streams": true,
    "expiry_emits_no_learned_authority": true,
    "same_stream_id_after_expiry_requires_new_lifecycle": true,
    "not_wired_to_async_event_bus": true,
    "rationale": "Longer than AsyncEventBus default handler timeout (2s) so a slow handler cannot expire an in-flight stream; short enough to forbid indefinite residency."
  },
  "capacity_policy": {
    "on_limit_reached": "FAIL_CLOSED",
    "silent_eviction_of_active_streams_forbidden": true,
    "lru_eviction_of_active_streams_forbidden": true,
    "deterministic_idle_expiry_cleanup_before_capacity_rejection": true,
    "after_expiry_cleanup_if_still_full": "REJECT_NEW_STREAM"
  },
  "multi_stream_isolation": {
    "required": true,
    "interleaved_streams_must_match_independent_execution": true,
    "no_cross_stream_state_read_or_mutation": true,
    "example_interleave": ["A0", "B0", "A1", "B1", "A19", "B19"]
  },
  "authority": {
    "tool_authority": false,
    "physical_actuation_authority": false,
    "policy_authority": false,
    "memory_mutation_authority": false,
    "reflex_external_authority": false
  },
  "future_phase4_parity": {
